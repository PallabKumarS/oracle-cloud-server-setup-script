# ==============================================================================
# Oracle Cloud Infrastructure (OCI) Always Free ARM VM Auto-Launcher
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Account (Account 1) - OCI API Credentials
# In Oracle Console: Profile (top right) -> My Profile / User Settings -> API Keys -> "Add API Key"
# Download the Private Key (.pem) and save it locally.
# ------------------------------------------------------------------------------
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=ap-singapore-1
OCI_PRIVATE_KEY_PATH=./oci_private_key.pem
OCI_SSH_PUBLIC_KEY="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."

# Optional: Root compartment defaults to OCI_TENANCY_OCID if omitted
# OCI_COMPARTMENT_OCID=

# ------------------------------------------------------------------------------
# 2. Secondary Account (Account 2) - Multi-Account / Multi-Region (Optional)
# Allows concurrent dual API requests to alternate regions (e.g. ap-sydney-1)
# ------------------------------------------------------------------------------
OCI_USER_OCID2=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_TENANCY_OCID2=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT2=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION2=ap-sydney-1
OCI_PRIVATE_KEY_PATH2=./oci_private_key2.pem
OCI_SSH_PUBLIC_KEY2="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."

# Optional: Account 2 compartment
# OCI_COMPARTMENT_OCID2=

# ------------------------------------------------------------------------------
# 3. Instance Configuration & Specifications
# Always Free Ampere A1 Allocation: Up to 4 OCPUs, 24 GB RAM, 200 GB Storage total.
# Recommended 2-VM Setup: 1 OCPU, 6 GB RAM, 100 GB Boot Disk per VM (backend & frontend).
# ------------------------------------------------------------------------------
OCI_INSTANCE_NAMES=backend,frontend
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1
OCI_MEMORY_IN_GBS=6
OCI_BOOT_VOLUME_SIZE_IN_GBS=100
OCI_BOOT_VOLUME_VPU=10
OCI_ASSIGN_PUBLIC_IP=true

# Optional: Target a specific fault domain (e.g. FAULT-DOMAIN-1), or leave blank for auto/any
# OCI_FAULT_DOMAIN=

# Optional: Explicit image OCID (if omitted, automatically resolves latest Canonical Ubuntu 24.04 ARM)
# OCI_IMAGE_OCID=
# OCI_IMAGE_OCID2=

# ------------------------------------------------------------------------------
# 4. Networking Settings (Auto-Resolved if left blank)
# If left blank, the script automatically searches for an existing public subnet,
# or creates a fresh VCN and Internet-Gateway-enabled subnet if none exists.
# ------------------------------------------------------------------------------
# OCI_SUBNET_NAME=subnet-nodejs
# OCI_VCN_NAME=vcn-nodejs
# OCI_SUBNET_OCID=
# OCI_SUBNET_OCID2=

# ------------------------------------------------------------------------------
# 5. Retry Interval & Rate Limiting
# Delay between polling cycles in seconds (recommended: 85-90 seconds to avoid 429 rate limits)
# ------------------------------------------------------------------------------
OCI_RETRY_INTERVAL_SECONDS=90

# ------------------------------------------------------------------------------
# 6. Email Notification Configuration (Gmail SMTP)
# Automatically sends an email with full instance credentials and IP when a VM is provisioned.
# ------------------------------------------------------------------------------
SENDER_EMAIL=your-email@gmail.com
SENDER_APP_PASS=your-google-app-password
RECIPIENT_EMAIL=your-notification-email@gmail.com

